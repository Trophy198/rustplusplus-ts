{
  "compilerOptions": {
    "target": "ESNext",
    "rootDir": ".",
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "types": [
      "node"
    ]
  },
  "include": ["index.ts", "src/**/*", "scripts/**/*"]
}